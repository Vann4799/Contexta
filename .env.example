ENVIRONMENT=development
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_STORAGE_BUCKET=contexta-documents

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=contexta_chunks
# Swapping EMBEDDING_PROVIDER or the chunker needs a new collection name plus a reindex:
# the worker and api refuse a collection indexed by a different model.

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MAX_TOKENS=3500
DEEPSEEK_THINKING=true
DEEPSEEK_REWRITE_MODEL=deepseek-chat

EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=4
EMBEDDING_DIMENSIONS=384
EMBEDDING_REMOTE_URL=

MAX_CHUNK_WORDS=500
CHUNK_OVERLAP_WORDS=100
MIN_CHUNK_WORDS=40

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
NEXT_PUBLIC_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback
