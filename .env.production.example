ENVIRONMENT=production
API_DOMAIN=api.your-domain.com
API_CORS_ORIGINS=https://web-hazel-beta-36.vercel.app

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_STORAGE_BUCKET=contexta-documents

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=replace-with-a-long-random-secret
QDRANT__SERVICE__API_KEY=replace-with-the-same-long-random-secret
QDRANT_COLLECTION=contexta_chunks
# Swapping EMBEDDING_PROVIDER or the chunker needs a new collection name plus a reindex
# (python -m worker.reindex): the worker and api refuse a collection indexed by another model.

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MAX_TOKENS=3500
# DeepSeek bills thinking tokens inside DEEPSEEK_MAX_TOKENS, so a long chain of thought
# can eat the whole budget and return no answer. Set false to spend every token on the answer.
DEEPSEEK_THINKING=true
DEEPSEEK_REWRITE_MODEL=deepseek-chat

# The sidecar container loads this model once; api and worker call it over HTTP.
# bge-m3 is deliberately not the default here: 1024 dims and ~2 GB of weights do
# not fit this host, and a deterministic hash would quietly score worse.
EMBEDDING_PROVIDER=remote
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=4
EMBEDDING_DIMENSIONS=384
EMBEDDING_REMOTE_URL=http://embeddings:8070

# Only needed for EMBEDDING_PROVIDER=openai|openrouter (an OpenAI-shaped /embeddings API).
# Never commit a key: these two lines belong in .env.production on the host only.
# text-embedding-3-small returns 1536 dims, so switching to it also means a new
# QDRANT_COLLECTION plus a reindex.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# Hybrid retrieval: a second arm embeds the same chunks into a second named vector
# slot of the SAME collection, and results are merged by reciprocal rank fusion.
# With one arm the slot stays unnamed (EMBEDDING_VECTOR_NAME empty), which is what
# the current contexta_chunks_v2 collection uses. Enabling a second arm means both
# slots must be named, a new QDRANT_COLLECTION, and a reindex.
# The query then costs one extra embedding call; measured ~840 ms on OpenRouter
# against ~60 ms for the local sidecar, so the two arms run concurrently.
EMBEDDING_VECTOR_NAME=
SECONDARY_EMBEDDING_PROVIDER=
SECONDARY_EMBEDDING_MODEL_NAME=text-embedding-3-small
SECONDARY_EMBEDDING_DIMENSIONS=1536
SECONDARY_EMBEDDING_VECTOR_NAME=openai
# Fill in on the host only, never commit:
SECONDARY_EMBEDDING_BASE_URL=
SECONDARY_EMBEDDING_API_KEY=

# How many candidates each arm asks Qdrant for before fusion. Fusion trusts rank
# position, so a deeper pool can reorder the final top_k while the answer sent to
# the model stays the configured size. The cost is a slightly larger Qdrant read,
# not another embedding call. Measured on 20 cases with the answer still cut to 5:
# hit@5 0.80 at both 5 and 10, hit@1 0.40 -> 0.45, mrr@5 0.5558 -> 0.5667, i.e. a
# reshuffle rather than a jump, and within the noise of a 20-case set.
RETRIEVAL_ARM_WINDOW=10

# apps/mcp is a protocol adapter: it holds no secret of its own and forwards the
# caller's API key to the api over the compose network. This is the only value it
# reads from here. Setting it turns on the MCP SDK's DNS-rebinding guard for /mcp,
# which also rejects any request carrying an Origin header -- that is intended, /mcp
# is a surface for agents, not for browsers. Leave empty to skip the guard.
MCP_ALLOWED_HOSTS=api.your-domain.com
